# Reproducible Rust validation — mirrors .github/workflows/ci.yml (rust job).
# Build: docker build -f docker/ci/Dockerfile.rust -t medoc-rust-ci .
# Run:   docker run --rm -v "$PWD:/work" -v medoc-target:/work/app/target medoc-rust-ci

FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
    librsvg2-dev libsoup-3.0-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt clippy

ENV PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV MEDOC_VENDOR_PUBKEY=79c1662a9e6877dd6b2156324ee33b969e1076393a91fbe9b2976596dca81b32
ENV MEDOC_DB_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENV MEDOC_AUDIT_KEY=k9-medoc-test-audit-key-32bytes!

WORKDIR /work/app

COPY docker/ci/run-rust-validate.sh /usr/local/bin/run-rust-validate.sh
RUN chmod +x /usr/local/bin/run-rust-validate.sh

CMD ["/usr/local/bin/run-rust-validate.sh"]
