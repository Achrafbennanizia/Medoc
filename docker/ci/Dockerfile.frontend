# Reproducible frontend validation — mirrors .github/workflows/ci.yml (frontend job).
# Build: docker build -f docker/ci/Dockerfile.frontend -t medoc-fe-ci .
# Run:   docker run --rm -v "$PWD:/work" medoc-fe-ci:latest

FROM node:20-bookworm-slim

WORKDIR /work

CMD ["bash", "-lc", "\
  set -euo pipefail; \
  echo '=== npm ci ==='; \
  npm ci; \
  echo '=== npm run lint ==='; \
  npm run lint; \
  echo '=== npm test ==='; \
  npm test; \
  echo '=== npm run build ==='; \
  npm run build; \
  echo '=== validate-lan-web-client ==='; \
  ./scripts/validate-lan-web-client.sh; \
  echo '=== PASS ===' \
"]
