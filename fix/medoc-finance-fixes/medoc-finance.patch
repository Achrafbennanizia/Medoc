+#[tokio::test]
+async fn open_items_double_billing_and_reminders() {
+    let pool = setup().await;
+    let s = session("PHYSICIAN");
+    let date = day(-40);
+
+    // Unreleased treatment cannot be invoiced.
+    let err = issue_invoice(&pool, &s, IssueInvoiceArgs { patient_id: "p1".into(), invoice: invoice(&date, "treatment:t2", 8000), preview: true })
+        .await
+        .unwrap_err();
+    assert!(err.to_string().contains("not_released"), "{err}");
+
+    let inv = issue_invoice(&pool, &s, IssueInvoiceArgs { patient_id: "p1".into(), invoice: invoice(&date, "treatment:t1", 12000), preview: false })
+        .await
+        .unwrap();
+    let id = inv.document_id.clone().unwrap();
+
+    // Same treatment again: refused.
+    let err = issue_invoice(&pool, &s, IssueInvoiceArgs { patient_id: "p1".into(), invoice: invoice(&date, "treatment:t1", 12000), preview: false })
+        .await
+        .unwrap_err();
+    assert!(err.to_string().contains("already_invoiced"), "{err}");
+
+    // 40 € paid, due 14 days after the invoice date → overdue.
+    pay(&pool, "z1", 4000, "BANK_TRANSFER", -10, Some("t1")).await;
+    let row = receivables::invoice_status(&pool, &s, &id).await.unwrap();
+    assert_eq!(row.paid_cents, 4000);
+    assert_eq!(row.open_cents, 8000);
+    assert_eq!(row.payment_state, "OVERDUE");
+    assert_eq!(row.due_date.as_deref(), Some(day(-26).as_str()));
+    assert_eq!(row.next_reminder_level, Some(1));
+
+    // No fee on the first reminder.
+    assert!(receivables::issue_reminder(&pool, &s, ReminderArgs { invoice_document_id: id.clone(), fee_cents: 500, ..Default::default() })
+        .await
+        .is_err());
+    let preview = receivables::issue_reminder(&pool, &s, ReminderArgs { invoice_document_id: id.clone(), preview: true, ..Default::default() })
+        .await
+        .unwrap();
+    assert!(preview.document_number.is_none());
+    let r1 = receivables::issue_reminder(&pool, &s, ReminderArgs { invoice_document_id: id.clone(), ..Default::default() })
+        .await
+        .unwrap();
+    let year = chrono::Local::now().format("%Y").to_string();
+    assert_eq!(r1.document_number.as_deref(), Some(format!("MA-{year}-000001").as_str()));
+    // Next level only after the new deadline passed.
+    assert!(receivables::issue_reminder(&pool, &s, ReminderArgs { invoice_document_id: id.clone(), ..Default::default() })
+        .await
+        .is_err());
+    assert!(sqlx::query("DELETE FROM payment_reminder").execute(&pool).await.is_err());
+
+    // Rest paid → PAID, no reminder possible.
+    pay(&pool, "z2", 8000, "CASH", 0, Some("t1")).await;
+    let open = receivables::list_invoices(&pool, &s, InvoiceListFilter { open_only: true, ..Default::default() })
