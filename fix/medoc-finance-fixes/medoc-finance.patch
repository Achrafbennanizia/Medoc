+#[tokio::test]
+async fn day_close_is_computed_locked_and_carried_forward() {
+    let pool = setup().await;
+    let s = session("PHYSICIAN");
+    let reception = session("RECEPTION");
+
+    // Day -3: 100 € float, 45 € cash, 30 € card.
+    cash_book::record_cash_movement(
+        &pool,
+        &s,
+        CashMovementArgs { kind: "OPENING_FLOAT".into(), amount_cents: 10000, reason: "Wechselgeld".into(), receipt_ref: None },
+    )
+    .await
+    .unwrap();
+    // Movements are booked "now"; move this one to day -3 for the test.
+    sqlx::query("DROP TRIGGER trg_cash_movement_no_update").execute(&pool).await.unwrap();
+    sqlx::query("UPDATE cash_movement SET occurred_at = ?1, local_day = ?2").bind(noon_utc(-3)).bind(day(-3))
+        .execute(&pool).await.unwrap();
+    pay(&pool, "z1", 4500, "CASH", -3, None).await;
+    pay(&pool, "z2", 3000, "CARD", -3, None).await;
+
+    let draft = cash_book::prepare(&pool, &s, &day(-3)).await.unwrap();
+    assert_eq!(draft.opening_cents, 0);
+    assert_eq!(draft.cash_receipts_cents, 4500);
+    assert_eq!(draft.cash_movements_cents, 10000);
+    assert_eq!(draft.expected_cents, 14500);
+    assert_eq!(draft.card_cents, 3000);
+
+    // Reception may not close; a count is mandatory; a difference needs a reason.
+    assert!(cash_book::close_day(&pool, &reception, counted(14500, None, &day(-3))).await.is_err());
+    let err = cash_book::close_day(&pool, &s, CloseDayArgs { as_of_date: day(-3), ..Default::default() })
+        .await
+        .unwrap_err();
+    assert!(err.to_string().contains("counted_required"), "{err}");
+    let err = cash_book::close_day(&pool, &s, counted(14400, None, &day(-3))).await.unwrap_err();
+    assert!(err.to_string().contains("variance_note_required"), "{err}");
+
+    // Count by denominations: 100 € + 2×20 € + 4×1 € = 144 €, 1 € short.
+    let mut denom = BTreeMap::new();
+    denom.insert("10000".to_string(), 1);
+    denom.insert("2000".to_string(), 2);
+    denom.insert("100".to_string(), 4);
+    let closed = cash_book::close_day(
+        &pool,
+        &s,
+        CloseDayArgs {
+            as_of_date: day(-3),
+            denominations: Some(denom),
+            card_terminal_cents: Some(3000),
+            note: Some("1 € Wechselgeld falsch herausgegeben".into()),
+            ..Default::default()
+        },
+    )
+    .await
+    .unwrap();
+    assert_eq!(closed.counted_cents, 14400);
+    assert_eq!(closed.variance_cents, -100);
+    let year = chrono::Local::now().format("%Y").to_string();
+    assert_eq!(closed.report.document_number.as_deref(), Some(format!("TB-{year}-000001").as_str()));
+
+    // Same day again: refused. Protocol cannot be deleted or changed.
+    assert!(cash_book::close_day(&pool, &s, counted(14400, Some("x"), &day(-3))).await.is_err());
+    assert!(sqlx::query("DELETE FROM day_close_protocol").execute(&pool).await.is_err());
+    assert!(sqlx::query("UPDATE day_close_protocol SET counted_cents = 1").execute(&pool).await.is_err());
+    // Closed journal lines are locked.
+    assert!(sqlx::query("UPDATE payment_receipt SET day_close_id = NULL").execute(&pool).await.is_err());
+
+    // A client-built daily report is no longer accepted.
+    let fake = ReportPdfInput { doc_title: "x".into(), report_kind: Some("daily_report".into()), ..Default::default() };
+    let err = issue_report(&pool, &s, fake, Some(day(-3)), false).await.unwrap_err();
+    assert!(err.to_string().contains("use_close_day"));
+
+    // Day -2: opening = counted cash of day -3; a 0 € placeholder from
+    // day -3 is filled today-2 → booked on day -2, not on its creation day.
+    sqlx::query(
+        "INSERT INTO payment (id, patient_id, amount, payment_method, status, amount_expected, created_at)
+         VALUES ('z3','p1',0,'CASH','OUTSTANDING',50,?1)",
+    )
+    .bind(noon_utc(-4))
+    .execute(&pool)
+    .await
+    .unwrap();
+    sqlx::query("UPDATE payment SET amount = 50, status = 'PAID' WHERE id = 'z3'").execute(&pool).await.unwrap();
+    // The trigger books "now"; shift the line to day -2 for the test.
+    sqlx::query("DROP TRIGGER trg_payment_receipt_no_update").execute(&pool).await.unwrap();
+    sqlx::query("UPDATE payment_receipt SET received_at = ?1, local_day = ?2 WHERE payment_id = 'z3'")
+        .bind(noon_utc(-2)).bind(day(-2)).execute(&pool).await.unwrap();
+
+    // Bank deposit of 100 €.
+    let dep = cash_book::record_cash_movement(
+        &pool,
+        &s,
+        CashMovementArgs { kind: "BANK_DEPOSIT".into(), amount_cents: 10000, reason: "Einzahlung Sparkasse".into(), receipt_ref: Some("EZ-17".into()) },
+    )
+    .await
+    .unwrap();
+    sqlx::query("UPDATE cash_movement SET occurred_at = ?1, local_day = ?2 WHERE id = ?3")
+        .bind(noon_utc(-2)).bind(day(-2)).bind(&dep.id).execute(&pool).await.unwrap();
+    // Cash expense needs a voucher.
+    assert!(cash_book::record_cash_movement(
+        &pool,
+        &s,
+        CashMovementArgs { kind: "EXPENSE".into(), amount_cents: 500, reason: "Porto".into(), receipt_ref: None },
+    )
+    .await
+    .is_err());
+
+    let d2 = cash_book::prepare(&pool, &s, &day(-2)).await.unwrap();
+    assert_eq!(d2.opening_cents, 14400, "carried from the counted cash of day -3");
+    assert_eq!(d2.cash_receipts_cents, 5000);
+    assert_eq!(d2.cash_movements_cents, -10000);
+    assert_eq!(d2.expected_cents, 9400);
+    let c2 = cash_book::close_day(&pool, &s, counted(9400, None, &day(-2))).await.unwrap();
+    assert_eq!(c2.variance_cents, 0);
+
+    // Closing an earlier day after a later one is refused.
+    assert!(cash_book::close_day(&pool, &s, counted(0, None, &day(-5))).await.is_err());
+    // Future dates are refused.
+    assert!(cash_book::close_day(&pool, &s, counted(0, None, &day(1))).await.is_err());
+
+    // Correction of the latest closing; the original turns CORRECTED.
+    let fixed = cash_book::correct_day_close(&pool, &s, &c2.protocol_id, counted(9300, Some("Nachgezählt: 1 Schein fehlte"), ""))
+        .await
+        .unwrap();
+    assert_eq!(fixed.variance_cents, -100);
+    let status: String = sqlx::query_scalar("SELECT status FROM day_close_protocol WHERE id = ?1")
+        .bind(&c2.protocol_id).fetch_one(&pool).await.unwrap();
+    assert_eq!(status, "CORRECTED");
+    // The earlier closing can no longer be corrected (balance carried on).
+    assert!(cash_book::correct_day_close(&pool, &s, &closed.protocol_id, counted(1, Some("x"), "")).await.is_err());
+
+    let copy = cash_book::report_copy(&pool, &s, &fixed.protocol_id).await.unwrap();
+    assert!(copy.reprint);
+
+    // Write the Kassenbericht for a visual check.
+    if let Ok(dir) = std::env::var("MEDOC_PDF_SAMPLE_DIR") {
+        use base64::Engine;
+        let b = base64::engine::general_purpose::STANDARD;
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(format!("{dir}/10-kassenbericht.pdf"), b.decode(&closed.report.pdf_base64).unwrap()).unwrap();
+        std::fs::write(format!("{dir}/11-kassenbericht-korrektur.pdf"), b.decode(&fixed.report.pdf_base64).unwrap()).unwrap();
+    }
+}
