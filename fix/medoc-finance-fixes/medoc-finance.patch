+        assert_eq!(m, 29589);
+        // Contract ended before the period.
+        assert_eq!(
+            contract_share_cents(50.0, "MONTH", None, Some(d("2025-12-31")), d("2026-01-01"), d("2026-03-31")),
+            0
+        );
+    }
