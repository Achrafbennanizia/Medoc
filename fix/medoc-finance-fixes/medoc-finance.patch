+        "OPENING_FLOAT" | "DEPOSIT" => Ok(1),
+        "WITHDRAWAL" | "BANK_DEPOSIT" | "EXPENSE" => Ok(-1),
+        _ => Err(AppError::validation_code("error.cash_book.bad_movement_kind")),
+    }
+}
