{
    "name": "medoc-workspace",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "workspaces": [
        "apps/practice-host-ui",
        "apps/lan-web-client",
        "packages/shared",
        "packages/ui",
        "packages/app/practice-host",
        "packages/server/lan",
        "packages/server/company"
    ],
    "scripts": {
        "dev": "npm run dev -w medoc",
        "build": "npm run build -w medoc && npm run build -w medoc-lan-web-client",
        "lint": "npm run lint -w medoc",
        "lint:fix": "npm run lint:fix -w medoc",
        "typecheck": "npm run typecheck -w medoc && npm run typecheck -w medoc-lan-web-client",
        "test": "npm run test -w medoc",
        "test:mvp-coverage": "npm run test:mvp-coverage -w medoc",
        "test:a11y": "bash scripts/test-a11y.sh",
        "format": "npm run format -w medoc",
        "check": "npm run lint && npm run typecheck && npm run build && npm run test",
        "i18n:verify": "node scripts/i18n-verify-parity.mjs",
        "i18n:scan": "node scripts/i18n-scan-hardcoded.mjs",
        "i18n:apply-patches": "node scripts/i18n-apply-translation-patches.mjs",
        "i18n:merge-pass4": "node scripts/i18n-merge-pass4-chunks.mjs && node scripts/i18n-apply-translation-patches.mjs",
        "i18n:extract": "node scripts/extract-i18n-catalog.mjs",
        "tauri": "npm run tauri -w medoc",
        "dev:lan-web": "npm run dev -w medoc-lan-web-client",
        "build:lan-web": "npm run build -w medoc-lan-web-client"
    }
}
